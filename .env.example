# ─── Database (Railway provides this automatically) ───────────────
DATABASE_URL="postgresql://rescuegrid:rescuegrid_secret@localhost:5432/rescuegrid"

# ─── JWT ──────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS — must match your Vercel frontend URL exactly ───────────
FRONTEND_URL=https://your-app-name.vercel.app

# ─── AI Provider ──────────────────────────────────────────────────
# Set to 'development' for rule-based mock, 'openai' for real LLM
AI_PROVIDER=development
OPENAI_API_KEY=

# ─── File Upload ──────────────────────────────────────────────────
MAX_FILE_SIZE=10mb
UPLOAD_DIR=./uploads
